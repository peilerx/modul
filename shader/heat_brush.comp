#version 450

// Screen-space disk: one thread = one pixel under the cursor.
// Ray is the same as cubes_ray. Heat lives on the visible cube, not a grid AABB.
// heat[i] >= 0 → time when heat hits 0. heat[i] < 0 → destroyed.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D dst;
layout(set = 0, binding = 1) buffer Heat {
    float heat[];
};

layout(push_constant) uniform Pc {
    mat4 inv_mvp;
    vec4 cam;   // xyz eye
    vec4 mouse; // ndc.xy · add_per_sec · radius_px
    vec4 timek; // dt, hold, cool, now
    vec4 meltk; // melt_rate, melt_boost, paint, pad
    uvec4 grid; // nx ny nz n
    vec4 view;  // pitch, width, height, pad
} pc;

const float DESTROYED_HEAT = 2.0;

bool ray_vol(vec3 ro, vec3 rd, vec3 bmin, vec3 bmax, out float t_enter, out float t_exit) {
    vec3 invd = 1.0 / rd;
    vec3 t0 = (bmin - ro) * invd;
    vec3 t1 = (bmax - ro) * invd;
    vec3 tsm = min(t0, t1);
    vec3 tlg = max(t0, t1);
    t_enter = max(max(tsm.x, tsm.y), tsm.z);
    t_exit = min(min(tlg.x, tlg.y), tlg.z);
    if (t_exit < max(t_enter, 0.0)) {
        return false;
    }
    t_enter = max(t_enter, 0.0);
    return true;
}

bool ray_aabb(vec3 ro, vec3 rd, vec3 bmin, vec3 bmax, inout float t_best) {
    vec3 invd = 1.0 / rd;
    vec3 t0 = (bmin - ro) * invd;
    vec3 t1 = (bmax - ro) * invd;
    vec3 tsm = min(t0, t1);
    vec3 tlg = max(t0, t1);
    float t_enter = max(max(tsm.x, tsm.y), tsm.z);
    float t_exit = min(min(tlg.x, tlg.y), tlg.z);
    if (t_exit < max(t_enter, 0.0)) {
        return false;
    }
    float t_hit = t_enter > 0.0 ? t_enter : 0.0;
    if (t_hit >= t_best) {
        return false;
    }
    t_best = t_hit;
    return true;
}

float heat_now(float stored, float now, float cool) {
    if (stored < 0.0) {
        return DESTROYED_HEAT;
    }
    return clamp((stored - now) * cool, 0.0, DESTROYED_HEAT);
}

bool first_live(
    vec3 ro,
    vec3 rd,
    uint nx,
    uint ny,
    uint nz,
    uint n,
    float pitch,
    vec3 c0,
    out uint hit_lin,
    out float hit_h
) {
    vec3 vol_min = -c0 * pitch - vec3(0.51);
    vec3 vol_max = c0 * pitch + vec3(0.51);
    float t_vol0;
    float t_vol1;
    if (!ray_vol(ro, rd, vol_min, vol_max, t_vol0, t_vol1)) {
        return false;
    }

    float now = pc.timek.w;
    float cool = max(pc.timek.z, 1e-3);
    float t_best = t_vol1 + 1e-3;
    bool hit = false;
    hit_lin = n;
    hit_h = 0.0;

    int i0 = 0;
    int i1 = int(ny) - 1;
    int istep = 1;
    if (rd.y < 0.0) {
        i0 = int(ny) - 1;
        i1 = 0;
        istep = -1;
    }

    uint plane = nx * ny;
    for (int iy = i0; iy != i1 + istep; iy += istep) {
        float cy = (float(iy) - c0.y) * pitch;
        float y0 = cy - 0.5;
        float y1 = cy + 0.5;
        float t_lo;
        float t_hi;
        if (abs(rd.y) < 1e-7) {
            if (ro.y < y0 || ro.y > y1) {
                continue;
            }
            t_lo = t_vol0;
            t_hi = t_vol1;
        } else {
            float ta = (y0 - ro.y) / rd.y;
            float tb = (y1 - ro.y) / rd.y;
            t_lo = min(ta, tb);
            t_hi = max(ta, tb);
            if (t_hi < t_vol0 || t_lo > t_vol1) {
                continue;
            }
            t_lo = max(t_lo, t_vol0);
            t_hi = min(t_hi, t_vol1);
        }
        if (t_hi < t_lo || t_lo >= t_best) {
            continue;
        }
        t_hi = min(t_hi, t_best);

        vec3 lmin = vec3((-c0.x) * pitch - 0.5, y0, (-c0.z) * pitch - 0.5);
        vec3 lmax = vec3((float(nx - 1u) - c0.x) * pitch + 0.5, y1, (float(nz - 1u) - c0.z) * pitch + 0.5);
        float lt0;
        float lt1;
        if (!ray_vol(ro, rd, lmin, lmax, lt0, lt1)) {
            continue;
        }
        t_lo = max(t_lo, lt0);
        t_hi = min(t_hi, lt1);
        if (t_hi < t_lo || t_lo >= t_best) {
            continue;
        }

        vec2 p = ro.xz + rd.xz * t_lo;
        ivec2 cell = ivec2(
            int(floor(p.x / pitch + c0.x + 0.5)),
            int(floor(p.y / pitch + c0.z + 0.5))
        );
        ivec2 st = ivec2(rd.x >= 0.0 ? 1 : -1, rd.z >= 0.0 ? 1 : -1);
        float bx = (float(cell.x) - c0.x + (st.x > 0 ? 0.5 : -0.5)) * pitch;
        float bz = (float(cell.y) - c0.z + (st.y > 0 ? 0.5 : -0.5)) * pitch;
        vec2 tMax;
        tMax.x = abs(rd.x) < 1e-8 ? 1e30 : (bx - p.x) / rd.x;
        tMax.y = abs(rd.z) < 1e-8 ? 1e30 : (bz - p.y) / rd.z;
        vec2 tDel;
        tDel.x = abs(rd.x) < 1e-8 ? 1e30 : abs(pitch / rd.x);
        tDel.y = abs(rd.z) < 1e-8 ? 1e30 : abs(pitch / rd.z);
        int maxk = int(nx) + int(nz) + 4;
        float t_cur = t_lo;
        for (int k = 0; k < maxk; k++) {
            if (t_cur > t_hi) {
                break;
            }
            if (cell.x >= 0 && cell.y >= 0 && cell.x < int(nx) && cell.y < int(nz)) {
                uint lin = uint(cell.x) + uint(iy) * nx + uint(cell.y) * plane;
                if (lin < n) {
                    float stored = heat[lin];
                    if (stored >= 0.0) {
                        vec3 center = vec3(
                            (float(cell.x) - c0.x) * pitch,
                            cy,
                            (float(cell.y) - c0.z) * pitch
                        );
                        float t_hit = t_best;
                        if (ray_aabb(ro, rd, center - vec3(0.5), center + vec3(0.5), t_hit)) {
                            t_best = t_hit;
                            t_hi = min(t_hi, t_best);
                            hit = true;
                            hit_lin = lin;
                            hit_h = heat_now(stored, now, cool);
                        }
                    }
                }
            }
            if (tMax.x < tMax.y) {
                cell.x += st.x;
                t_cur = t_lo + tMax.x;
                tMax.x += tDel.x;
            } else {
                cell.y += st.y;
                t_cur = t_lo + tMax.y;
                tMax.y += tDel.y;
            }
        }
    }
    return hit;
}

void main() {
    if (uint(pc.meltk.z + 0.5) == 0u) {
        return;
    }

    uint nx = max(pc.grid.x, 1u);
    uint ny = max(pc.grid.y, 1u);
    uint nz = max(pc.grid.z, 1u);
    uint n = max(pc.grid.w, 1u);
    float pitch = max(pc.view.x, 0.25);
    float src_w = max(pc.view.y, 1.0);
    float src_h = max(pc.view.z, 1.0);
    int rad = int(max(pc.mouse.w, 8.0) + 0.5);
    ivec2 off = ivec2(gl_GlobalInvocationID.xy) - ivec2(rad);
    float dist_px = length(vec2(off));
    if (dist_px > float(rad)) {
        return;
    }

    vec2 cursor = (pc.mouse.xy * 0.5 + 0.5) * vec2(src_w, src_h);
    vec2 pix = cursor + vec2(off);
    if (pix.x < 0.0 || pix.y < 0.0 || pix.x >= src_w || pix.y >= src_h) {
        return;
    }

    vec2 ndc = (pix + 0.5) / vec2(src_w, src_h) * 2.0 - 1.0;
    vec3 ro = pc.cam.xyz;
    vec4 p_far = pc.inv_mvp * vec4(ndc, 1.0, 1.0);
    vec3 far_w = p_far.xyz / max(p_far.w, 1e-6);
    vec3 rd = normalize(far_w - ro);
    vec3 c0 = vec3(float(nx - 1u), float(ny - 1u), float(nz - 1u)) * 0.5;

    uint lin;
    float h;
    if (!first_live(ro, rd, nx, ny, nz, n, pitch, c0, lin, h)) {
        return;
    }
    if (lin >= n || h >= DESTROYED_HEAT) {
        return;
    }

    float dt = max(pc.timek.x, 1e-4);
    float now = pc.timek.w;
    float cool = max(pc.timek.z, 1e-3);
    float fall = 1.0 - dist_px / max(float(rad), 1.0);
    fall = mix(0.45, 1.0, fall);
    float rate = pc.mouse.z;
    if (h >= 1.0) {
        rate = max(rate, pc.meltk.x) * (1.0 + pc.meltk.y);
    }
    h = min(h + rate * dt * fall, DESTROYED_HEAT);
    if (h >= DESTROYED_HEAT - 1e-4) {
        heat[lin] = -1.0;
    } else {
        heat[lin] = now + h / cool;
    }
}
